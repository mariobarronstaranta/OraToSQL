<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="UPDATE Cobza&#x0D;&#x0A;        SET Asignacion_Central = Acc.Assignment&#x0D;&#x0A;        FROM T3.CFDI_Cobranza AS Cobza&#x0D;&#x0A;        INNER JOIN EAI_Owner.tmp_Account_Header AS Acc&#x0D;&#x0A;            ON SUBSTRING(Cobza.Asignacion_ID, 3, 10)&#x0D;&#x0A;             = Acc.ClearingDocNumber&#x0D;&#x0A;           AND Acc.FiscalYear = CONVERT(VARCHAR(4), YEAR(GETDATE()))&#x0D;&#x0A;        INNER JOIN T3.Registro_Fiscal AS RF&#x0D;&#x0A;            ON RF.Factura = Cobza.Factura&#x0D;&#x0A;        -- Limite de medianoche: compara con &gt;, por lo que excluye exactamente&#x0D;&#x0A;        -- las 00:00 del dia limite. GETDATE se vuelve a evaluar en otros pasos.&#x0D;&#x0A;        WHERE Cobza.Fecha_Proceso &gt;&#x0D;&#x0A;              CAST(DATEADD(DAY, -ISNULL(@nDias, 0), GETDATE()) AS DATE)&#x0D;&#x0A;          -- Descarta coincidencia con entrega, valores reservados, factura&#x0D;&#x0A;          -- seguida de coma, prefijo 1-1 y referencia fiscal. Si las expresiones&#x0D;&#x0A;          -- quedan NULL, las comparaciones no pasan. No asigna si ya habia valor.&#x0D;&#x0A;          AND ISNULL(Acc.Assignment, RF.Entrega) &lt;&gt; RF.Entrega&#x0D;&#x0A;          AND ISNULL(Acc.Assignment, RF.Entrega) &lt;&gt; 'B001 - Bank I'&#x0D;&#x0A;          AND ISNULL(Acc.Assignment, RF.Entrega) &lt;&gt; Cobza.Factura + ','&#x0D;&#x0A;          AND ISNULL(Acc.Assignment, RF.Entrega) NOT LIKE '1-1%'&#x0D;&#x0A;          AND ISNULL(Acc.Assignment, RF.Entrega) &lt;&gt; RF.Referencia&#x0D;&#x0A;          AND Cobza.Asignacion_Central IS NULL" StatementId="1" StatementCompId="9" StatementType="UPDATE" StatementSqlHandle="0x0900F9ABF6EFD80A57AE6F5C7C13D43345770000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="3" ParentObjectId="1293247662" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="3153.22" StatementEstRows="174460" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xFCE94AEBA309D33F" QueryPlanHash="0x6721CAACC2885B74" CardinalityEstimationModelVersion="160" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"/><QueryPlan CachedPlanSize="144" CompileTime="45" CompileCPU="45" CompileMemory="3976"><ThreadStat Branches="1"/><MissingIndexes><MissingIndexGroup Impact="63.0232"><MissingIndex Database="[T3QA]" Schema="[T3]" Table="[CFDI_COBRANZA]"><ColumnGroup Usage="EQUALITY"><Column Name="[ASIGNACION_CENTRAL]" ColumnId="41"/></ColumnGroup><ColumnGroup Usage="INEQUALITY"><Column Name="[FECHA_PROCESO]" ColumnId="12"/></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[ASIGNACION_ID]" ColumnId="2"/><Column Name="[FACTURA]" ColumnId="8"/></ColumnGroup></MissingIndex></MissingIndexGroup><MissingIndexGroup Impact="63.0283"><MissingIndex Database="[T3QA]" Schema="[T3]" Table="[CFDI_COBRANZA]"><ColumnGroup Usage="EQUALITY"><Column Name="[ASIGNACION_CENTRAL]" ColumnId="41"/></ColumnGroup><ColumnGroup Usage="INEQUALITY"><Column Name="[FECHA_PROCESO]" ColumnId="12"/></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[ASIGNACION_ID]" ColumnId="2"/><Column Name="[FACTURA]" ColumnId="8"/></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="5120" SerialDesiredMemory="149096" GrantedMemory="0" MaxUsedMemory="0"/><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="352000" EstimatedPagesCached="704000" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="76222352"/><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-10-27T13:01:06.38" ModificationCount="1178" SamplingPercent="5.91462" Statistics="[_WA_Sys_00000018_47919582]" Table="[TMP_ACCOUNT_HEADER]" Schema="[EAI_O